{
  "name": "codex-unreal-blueprint",
  "version": "1.0.0",
  "description": "Production-grade Blueprint automation for Unreal Engine 4.27 and Codex",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Aaalice233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaalice233/codex-unreal-blueprint.git"
  },
  "homepage": "https://github.com/Aaalice233/codex-unreal-blueprint#readme",
  "bugs": {
    "url": "https://github.com/Aaalice233/codex-unreal-blueprint/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "codex-plugin",
    "mcp",
    "unreal-engine",
    "blueprint",
    "ue4"
  ],
  "scripts": {
    "build": "esbuild src/mcp/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mcp/index.js",
    "validate:plugin": "node scripts/validate-codex-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run validate:plugin && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
